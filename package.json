{
  "name": "agentabi",
  "version": "0.1.0",
  "description": "Local-first CLI for snapshotting terminal coding-agent operational ABIs.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "agentabi": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "node scripts/package-smoke.mjs",
    "check:ci-runtime": "node scripts/check-ci-runtime.mjs",
    "release:check": "npm run check:ci-runtime && npm test && npm run check && npm run build && npm run smoke && npm run package:smoke",
    "prebuild": "rm -rf dist",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent",
    "abi",
    "cli",
    "automation",
    "mcp",
    "snapshot"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/agentabi.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/agentabi/issues"
  },
  "homepage": "https://github.com/rogerchappel/agentabi#readme"
}
